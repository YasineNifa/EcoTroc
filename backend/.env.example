# Copy to backend/.env.dev for local development (docker compose)
POSTGRES_DB=ecotroc_db
POSTGRES_USER=ecotroc_user
POSTGRES_PASSWORD=ecotroc_password
POSTGRES_HOSTNAME=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Production (Railway): DATABASE_URL and REDIS_URL are injected automatically
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://eco-troc.vercel.app

# Demo user (create_demo_user command)
DEMO_USERNAME=demo
DEMO_EMAIL=demo@ecotroc.app
DEMO_PASSWORD=change-me
DEMO_TOKEN_BALANCE=100
